# DEVELOPMENT uses the development app identifier; PRODUCTION uses the release identifier.
RELEASE=DEVELOPMENT
# Use 10.0.2.2 for an Android emulator, or your computer's LAN address for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Native Google Maps SDK key (embedded in the native app at build time).
GOOGLE_MAPS_API_KEY=
# Google Places web service key (embedded in the JavaScript bundle).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
